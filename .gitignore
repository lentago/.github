# Local-only holding pen — relocated scratchpads kept on disk but NOT published
# (e.g. the PitziLabs portfolio mockup, which embeds Lentago lab LAN topology).
/archive/

# Python bytecode from the fleet-report generator
__pycache__/
*.pyc

# Terraform working state. The lock file IS committed — it pins provider hashes
# so CI and local runs resolve identically.
.terraform/
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
tfplan
*.tfplan

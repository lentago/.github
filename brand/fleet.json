{
  "_comment": [
    "Per-repo brand identity for the Lentago Labs fleet. Consumed by generate.py",
    "to emit brand/generated/<repo>/{banner.svg,og.png} and the README badge row.",
    "",
    "  mark    — basename in brand/marks/. Repos without their own genus mark",
    "            fall back to 'lentago' (the org blossom).",
    "  kind    — eyebrow category: SUITE | FLEET | SITE | LAB",
    "  tagline — mono line under the repo name. Keep <= 58 chars; it is set",
    "            uppercase by the generator.",
    "  prompt  — the '▲ lentago' field-prompt line. Keep <= 64 chars.",
    "  badges  — stack badges appended after the shared CI/license/DeepWiki set.",
    "            {label, logo} renders a shields.io simple-icons badge; a bare",
    "            {label} renders a text-only badge in the same Tidewater colors."
  ],

  "solidago": {
    "mark": "solidago",
    "kind": "SUITE",
